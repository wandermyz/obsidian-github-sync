{
  "name": "github-enterprise-sync",
  "version": "0.1.1",
  "description": "Sync notes with GitHub or GitHub Enterprise Server through the GitHub REST API, with no Git binary required. Signs in with OAuth device flow, so it works with enterprise SSO and on mobile, including iOS.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "deploy": "npm run build && node scripts/deploy-dev.mjs",
    "lint": "eslint src",
    "test": "node tests/unit/plan.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:e2e:login": "node tests/e2e/login.mjs",
    "test:app": "npm run build && node tests/app/run.mjs",
    "screenshots": "npm run build && node tests/app/screenshots.mjs"
  },
  "keywords": [
    "obsidian",
    "github",
    "github-enterprise",
    "sync"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.14.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2"
  }
}
