# Configuration for the end-to-end tests (npm run test:e2e).
#
# Copy to `.env.e2e` and fill in. `.env.e2e` is gitignored: it names a real
# repository the tests will commit to, and sits next to the cached token.

# The repository the tests create, modify and delete files in.
# It must be one you can push to, and must NOT hold anything you care about.
# The tests confine themselves to a unique subfolder per run and remove it
# afterwards, but treat the whole repo as expendable anyway.
E2E_REPO=owner/repo

# Branch to test against. Empty means the repository's default branch.
E2E_BRANCH=

# OAuth app client ID, with "Enable Device Flow" checked.
E2E_CLIENT_ID=

# github.com, or an Enterprise Server base URL.
E2E_GITHUB_WEB_BASE=https://github.com

# Scopes requested on first sign-in. `repo` is required — the tests push.
E2E_SCOPE=repo read:org
